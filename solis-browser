<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Solis Browser</title>
<style>
:root{
  --strip:#1c1b22; --tab:#42414d; --bar:#2b2a33; --field:#1c1b22; --page:#1c1b22;
  --tile:#42414d; --search:#42414d; --text:#fbfbfe; --muted:#9e9ea6; --hover:rgba(255,255,255,.1);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--page);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;overflow:hidden}
.win{display:flex;flex-direction:column;height:100%;padding-top:env(safe-area-inset-top,0px);background:var(--strip)}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
svg{display:block}

/* Tab strip */
.tabs{display:flex;align-items:center;height:48px;padding:0 12px;gap:6px;background:var(--strip)}
.lights{display:flex;gap:8px;margin-right:48px;flex:none}
.lights i{width:13px;height:13px;border-radius:50%;display:block}
.lights i:nth-child(1){background:#ff5f57}.lights i:nth-child(2){background:#febc2e}.lights i:nth-child(3){background:#28c840}
.tab{display:flex;align-items:center;gap:10px;height:36px;width:230px;min-width:0;padding:0 12px;border-radius:6px;font-size:15px;color:#e8e8ee;cursor:pointer;flex:0 1 230px}
.tab span{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tab.active{background:var(--tab);color:#fff}
.tab .fav{width:16px;height:16px;flex:none;display:grid;place-items:center;font:600 14px Georgia,serif;color:#cfcfd6}
.tab .x{width:20px;height:20px;border-radius:4px;display:grid;place-items:center;flex:none;color:#d7d7de}
.tab .x:hover{background:var(--hover)}
.newtab{width:32px;height:32px;border-radius:6px;display:grid;place-items:center;flex:none}
.newtab:hover,.ib:hover{background:var(--hover)}
.spacer{flex:1}
.list{width:32px;height:32px;display:grid;place-items:center;flex:none}

.tablist{display:flex;gap:6px;min-width:0;overflow-x:auto;scrollbar-width:none;flex:0 1 auto}
.tablist::-webkit-scrollbar{display:none}
.tab{min-width:90px}
.tab:not(.active):hover{background:rgba(255,255,255,.08)}
.welcome{display:none;flex-direction:column;align-items:center;gap:12px;margin-top:clamp(70px,16vh,110px);text-align:center}
.welcome svg{width:64px;height:64px}
.welcome h2{font-size:24px;font-weight:500}
.welcome p{font-size:14px;color:var(--muted)}
.welcome button{margin-top:6px;height:34px;padding:0 16px;border-radius:6px;background:#42414d;font-size:13px}
.welcome button:hover{background:#52515d}
.page.is-welcome .welcome{display:flex}
.page.is-welcome .hero,.page.is-welcome .search,.page.is-welcome .tiles,.page.is-welcome .custom{display:none}

/* Toolbar */
.toolbar{display:flex;align-items:center;gap:6px;height:44px;padding:0 12px;background:var(--bar)}
.ib{width:32px;height:32px;border-radius:6px;display:grid;place-items:center;flex:none;color:#e6e6ec}
.ib.dim{color:#6f6e78}
.url{flex:1;min-width:0;display:flex;align-items:center;gap:10px;height:36px;margin:0 6px;padding:0 12px;border-radius:6px;background:var(--field);font-size:17px;color:#9a9aa3;max-width:none}
.url input{flex:1;min-width:0;background:none;border:0;outline:0;color:#9a9aa3;font:inherit}
.url input:focus{color:#fff}
.url:focus-within{box-shadow:0 0 0 2px #7aa7ff}
.vpn{display:flex;align-items:center;gap:7px;height:30px;padding:0 10px;border-radius:5px;background:#42414d;font-size:16px;font-weight:500;flex:none}
.vpn .dot{width:14px;height:14px;border-radius:50%;background:#cfcfd6;display:grid;place-items:center}
.vpn .dot:after{content:"";width:0;height:0;border-left:5px solid #42414d;border-top:3.5px solid transparent;border-bottom:3.5px solid transparent;margin-left:1px}
.vpn.on .dot{background:#ff9a1f}.vpn.on .dot:after{border-left-color:#1c1b22}

/* Page */
.page{position:relative;flex:1;background:var(--page);overflow:auto;display:flex;flex-direction:column;align-items:center;padding:0 20px 60px}
.hero{margin-top:clamp(70px,16vh,86px);display:flex;align-items:center;gap:20px}
.hero svg{width:56px;height:56px}
.hero h1{font-size:25px;font-weight:500;letter-spacing:-.2px}
.search{margin-top:34px;width:min(388px,100%);height:30px;display:flex;align-items:center;gap:8px;padding:0 9px;border-radius:5px;background:var(--search)}
.search input{flex:1;min-width:0;background:none;border:0;outline:0;color:#fff;font:inherit;font-size:11px}
.search input::placeholder{color:#a9a9b1}
.search:focus-within{box-shadow:0 0 0 2px #7aa7ff}
.tiles{margin-top:34px;display:flex;flex-wrap:wrap;justify-content:center;gap:12px 12px;max-width:540px}
.tile{color:var(--text);width:38px;text-align:center;text-decoration:none;color:#e6e6ec;display:block}
.tile .ic{width:38px;height:38px;border-radius:8px;background:var(--tile);display:grid;place-items:center;transition:background .15s}
.tile:hover .ic{background:#52515d}
.tile .ic>*{width:22px;height:22px;border-radius:4px;display:grid;place-items:center;font-weight:700}
.tile small{display:block;margin-top:5px;font-size:8.5px;line-height:1.15;white-space:nowrap;margin-left:-8px;margin-right:-8px}
.tile em{display:block;font-style:normal;font-size:6.5px;color:#9a9aa3;margin:1px -8px 0}
.custom{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:6px;height:20px;padding:0 10px;border:1px solid #3d3c46;border-radius:10px;background:#25242c;font-size:9px;color:#d7d7de}
.custom:hover{background:#2f2e38}

/* Mobile */
@media (max-width:720px){
  .lights,.list,.hide-m{display:none}
  .tabs{height:44px;padding:0 8px}
  .tab{flex:0 0 150px;width:150px}
  .toolbar{padding:0 6px;gap:2px}
  .toolbar .ib.opt{display:none}
  .url{font-size:15px;margin:0 4px;height:34px}
  .vpn{font-size:14px;padding:0 8px}
  .hero{gap:14px}
  .hero h1{font-size:23px}
  .hero svg{width:50px;height:50px}
  .tiles{gap:18px 14px;max-width:340px}
  .tile{width:56px}
  .tile .ic{width:56px;height:56px;border-radius:11px}
  .tile .ic>*{width:30px;height:30px}
  .tile small{font-size:11px;margin-top:7px}
  .tile em{font-size:8.5px}
  .search{height:38px;width:100%;max-width:420px}
  .search input{font-size:14px}
  .custom{height:26px;font-size:11px;bottom:calc(10px + env(safe-area-inset-bottom,0px))}
}
@media (max-width:360px){.vpn span{display:none}.hero h1{font-size:20px}}
/* Extras */
.page{background:var(--pagebg,var(--page))}
.search{position:relative}
.sug{position:absolute;left:0;right:0;top:34px;z-index:20;background:var(--tab);border-radius:6px;box-shadow:0 6px 20px rgba(0,0,0,.35);padding:4px;display:none}
.sug.open{display:block}
.sug div{display:flex;gap:8px;align-items:center;padding:7px 8px;font-size:12px;border-radius:4px;cursor:pointer;color:var(--text)}
.sug div svg{flex:none;opacity:.6}
.sug div.sel,.sug div:hover{background:var(--hover)}
.info{position:absolute;top:14px;right:18px;display:flex;align-items:center;gap:14px;font-size:12px;color:var(--muted);text-align:right}
.info b{display:block;font-size:22px;font-weight:500;color:var(--text);line-height:1.1}
.info button{font-size:12px;color:var(--muted);padding:5px 8px;border-radius:5px}
.info button:hover{background:var(--hover)}
.page.is-welcome .info,.page.hide-info .info{display:none}
.page.hide-tiles .tiles{display:none}
.pop{position:fixed;z-index:50;top:calc(env(safe-area-inset-top,0px) + 92px);right:12px;width:290px;max-width:calc(100vw - 24px);background:var(--bar);color:var(--text);border-radius:10px;box-shadow:0 8px 30px rgba(0,0,0,.45);padding:8px;display:none;border:1px solid rgba(128,128,140,.25)}
.pop.open{display:block}
.pop.ctx{top:0;right:auto;width:170px}
.pop h3{font-size:14px;font-weight:600;padding:6px 8px}
.pop p,.modal p{font-size:12px;color:var(--muted);padding:2px 8px 6px;line-height:1.4}
.mi{display:flex;align-items:center;gap:10px;width:100%;text-align:left;padding:9px 10px;border-radius:6px;font-size:14px}
.mi:hover{background:var(--hover)}
.sep{height:1px;background:rgba(128,128,140,.25);margin:4px 0}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px;font-size:14px}
.row small{display:block;font-size:12px;color:var(--muted);margin-top:2px}
.sw{position:relative;width:38px;height:22px;border-radius:11px;background:#6f6e78;flex:none;transition:background .15s}
.sw:after{content:"";position:absolute;left:3px;top:3px;width:16px;height:16px;border-radius:50%;background:#fff;transition:transform .15s}
.sw.on{background:#f5821f}.sw.on:after{transform:translateX(16px)}
.pop select,.modal input,.modal select{width:100%;height:34px;border-radius:6px;border:1px solid rgba(128,128,140,.35);background:var(--field);color:var(--text);padding:0 10px;font:inherit;font-size:14px}
.pop select{margin:0 0 4px}
.pop .selwrap{padding:0 8px 4px}
.avatar{width:36px;height:36px;border-radius:50%;background:#f5821f;color:#1c1b22;display:grid;place-items:center;font-weight:700;flex:none}
.ov{position:fixed;inset:0;z-index:60;background:rgba(0,0,0,.5);display:none;align-items:center;justify-content:center;padding:16px}
.ov.open{display:flex}
.modal{background:var(--bar);color:var(--text);border-radius:12px;width:min(420px,100%);max-height:86vh;overflow:auto;padding:18px;border:1px solid rgba(128,128,140,.25)}
.modal h2{font-size:17px;font-weight:600;margin-bottom:8px}
.modal label{display:block;font-size:12px;color:var(--muted);margin:12px 0 5px}
.btns{display:flex;justify-content:flex-end;gap:8px;margin-top:16px;flex-wrap:wrap}
.btn{height:34px;padding:0 14px;border-radius:6px;background:var(--tile);font-size:13px;color:var(--text)}
.btn:hover{filter:brightness(1.15)}
.btn.pri{background:#f5821f;color:#1c1b22;font-weight:600}
.swatches{display:flex;gap:10px;flex-wrap:wrap}
.swatches button{width:32px;height:32px;border-radius:50%;border:2px solid transparent;outline:1px solid rgba(128,128,140,.4)}
.swatches button.sel{border-color:#f5821f}
.items a,.items .li{display:block;padding:9px 8px;font-size:14px;color:inherit;text-decoration:none;border-radius:6px;cursor:pointer;word-break:break-word}
.items a:hover,.items .li:hover{background:var(--hover)}
.tile{-webkit-touch-callout:none;user-select:none}
:root[data-theme="light"]{--strip:#f0f0f4;--tab:#fff;--bar:#f9f9fb;--field:#f0f0f4;--page:#fff;--tile:#e9e9ee;--search:#f0f0f4;--text:#15141a;--muted:#5b5b66;--hover:rgba(0,0,0,.08)}
[data-theme=light] .tab,[data-theme=light] .tab.active,[data-theme=light] .ib,[data-theme=light] .tile,[data-theme=light] .custom,[data-theme=light] .vpn,[data-theme=light] .tab .fav,[data-theme=light] .tab .x,[data-theme=light] .newtab,[data-theme=light] .tabs .list{color:#15141a}
[data-theme=light] .ib.dim{color:#a0a0aa}
[data-theme=light] .url,[data-theme=light] .url input{color:#5b5b66}
[data-theme=light] .url input:focus,[data-theme=light] .search input{color:#15141a}
[data-theme=light] .url svg{stroke:#5b5b66}
[data-theme=light] .tab.active{box-shadow:0 1px 3px rgba(0,0,0,.18)}
[data-theme=light] .vpn{background:#e0e0e6}
[data-theme=light] .vpn .dot{background:#5b5b66}
[data-theme=light] .custom{background:#f0f0f4;border-color:#d7d7db}
[data-theme=light] .tile:hover .ic,[data-theme=light] .welcome button:hover{background:#dcdce2}
[data-theme=light] .welcome button{background:#e9e9ee}
[data-theme=light] .search input::placeholder{color:#6b6b76}
[data-theme=light] .pop,[data-theme=light] .modal{box-shadow:0 8px 30px rgba(0,0,0,.18)}
@media (max-width:720px){
  .info{top:8px;right:12px}.info b{font-size:18px}
  .pop{right:8px}
}
</style>
</head>
