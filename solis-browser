  </defs>
</svg>
<div class="win">

  <div class="tabs">
    <div class="lights"><i></i><i></i><i></i></div>
    <div class="tablist" id="tabList"></div>
    <button class="newtab" id="newTabBtn" aria-label="New tab" title="New tab"><svg width="16" height="16" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 2v12M2 8h12"/></svg></button>
    <div class="spacer"></div>
    <button class="list" aria-label="Tüm sekmeler"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l5 5 5-5"/></svg></button>
  </div>

  <div class="toolbar">
    <button class="ib" aria-label="Geri"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10H4M9 5l-5 5 5 5"/></svg></button>
    <button class="ib dim opt" aria-label="İleri"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5"/></svg></button>
    <button class="ib opt" aria-label="Yenile" onclick="location.reload()"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M16 10a6 6 0 1 1-2-4.5M16 3v4h-4"/></svg></button>
    <button class="ib opt" aria-label="Ana sayfa"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 9.5L10 3l7 6.5M5 8.5V17h4v-4.5h2V17h4V8.5"/></svg></button>

    <form class="url" id="urlForm" autocomplete="off">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#c9c9d0" stroke-width="1.7" stroke-linecap="round"><circle cx="7.5" cy="7.5" r="5"/><path d="M11.5 11.5L16 16"/></svg>
      <input id="urlInput" type="text" value="https://solis.browser/newtab" aria-label="Adres çubuğu" spellcheck="false">
    </form>
    <button class="ib hide-m" aria-label="Hesap"><svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="9"/><circle cx="11" cy="9" r="3"/><path d="M5.5 17c1.2-2.4 3-3.4 5.5-3.4s4.300 1 5.500 3.400"/></svg></button>
    <button class="ib hide-m" aria-label="Uzantılar"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 8h2.500a2 2 0 1 1 4 0H12v3a2 2 0 1 1 0 4v2H3z"/><path d="M12 8h5v9h-5" /></svg></button>
    <button class="ib" aria-label="Menü"><svg width="20" height="20" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14"/></svg></button>
  </div>

  <main class="page">
    <div class="info" id="info"><div><b id="clk"></b><span id="dt"></span></div><button id="wx">Hava durumunu göster</button></div>
    <div class="welcome" id="welcome">
      <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#solis"/></svg>
      <h2>Welcome to Solis</h2>
      <p>Fast and simple browsing.</p>
      <button id="welcomeNew">Open new tab</button>
    </div>
    <div class="hero">
      <svg viewBox="0 0 100 100" aria-hidden="true"><use href="#solis"/></svg>
      <h1>Solis Browser</h1>
    </div>

    <form class="search" id="searchForm">
      <svg width="18" height="18" viewBox="0 0 128 128" aria-hidden="true"><circle cx="64" cy="64" r="64" fill="#de5833"/><path d="M40 98c-8-24-4-52 14-66 12-9 30-8 38 6 7 12 6 30 1 44-4 11-8 16-14 20-12 3-28 2-39-4z" fill="#d5d7d8"/><path d="M42 96C34 72 38 46 54 34c12-8 28-6 36 6 6 10 6 26 1 40-4 10-8 15-14 19-12 3-27 1-35-3z" fill="#fff"/><path d="M92 54c10 2 16 6 18 10-6 5-18 6-30 3z" fill="#fdd20a"/><circle cx="66" cy="50" r="12" fill="#fff" stroke="#2d4f8e" stroke-width="0"/><circle cx="66" cy="50" r="8.500" fill="#2d4f8e"/><circle cx="68.500" cy="47" r="2.800" fill="#fff"/><path d="M52 100c8 8 22 8 30 2l-2 8c-8 6-22 6-30-2z" fill="#65bc46"/><path d="M58 104c6 4 14 4 20 1" fill="none" stroke="#43a244" stroke-width="3" stroke-linecap="round"/></svg>
      <input id="q" type="text" autocomplete="off" placeholder="Search with DuckDuckGo or enter address" aria-label="Ara"><div class="sug" id="sug"></div>
    </form>

    <div class="tiles" id="tiles">
      <a class="tile" href="https://www.amazon.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#fff;color:#111;font:700 18px Arial,sans-serif;border-radius:4px;position:relative">a<i style="position:absolute;left:4px;right:4px;bottom:3px;height:2px;border-bottom:2px solid #ff9900;border-radius:0 0 8px 8px"></i></b></div><small>Amazon</small><em>Sponsored</em></a>
      <a class="tile" href="https://www.expedia.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#fcc72b;color:#1a2b6d"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#1a2b6d" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11L11 3M5 3h6v6"/></svg></b></div><small>Expedia</small><em>Sponsored</em></a>
      <a class="tile" href="https://www.temu.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#fb6a10;color:#fff;font:800 7px Arial,sans-serif;letter-spacing:-.2px">TEMU</b></div><small>Temu</small><em>Sponsored</em></a>
      <a class="tile" href="https://www.wikipedia.org" target="_blank" rel="noopener"><div class="ic"><b style="background:#fff;color:#111;font:600 15px Georgia,serif;border-radius:50%">W</b></div><small>Wikipedia</small></a>
      <a class="tile" href="https://www.youtube.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#fff;border-radius:5px"><svg width="18" height="13" viewBox="0 0 18 13"><rect width="18" height="13" rx="3.500" fill="#f00"/><path d="M7 3.500v6l5-3z" fill="#fff"/></svg></b></div><small>YouTube</small></a>
      <a class="tile" href="https://apnews.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#fff;color:#111;font:800 10px Arial,sans-serif;border-radius:3px;position:relative;letter-spacing:-.3px">AP<i style="position:absolute;left:2px;right:2px;bottom:2px;height:2px;background:#e4002b"></i></b></div><small>AP News</small></a>
      <a class="tile" href="https://www.reddit.com" target="_blank" rel="noopener"><div class="ic"><b style="background:#ff4500;border-radius:50%"><svg width="16" height="14" viewBox="0 0 16 14"><ellipse cx="8" cy="8.500" rx="6" ry="4.200" fill="#fff"/><circle cx="5.600" cy="8" r="1" fill="#ff4500"/><circle cx="10.400" cy="8" r="1" fill="#ff4500"/><circle cx="13" cy="4.500" r="1.200" fill="#fff"/><circle cx="8" cy="3" r="0" /><path d="M5.500 10.500c1.500 1 3.500 1 5 0" stroke="#ff4500" stroke-width=".8" fill="none" stroke-linecap="round"/></svg></b></div><small>Reddit</small></a>
      <a class="tile" href="#" id="addBtn"><div class="ic"><svg width="14" height="14" viewBox="0 0 14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style="border-radius:0"><path d="M7 1v12M1 7h12"/></svg></div><small>Add Shortcut</small></a>
    </div>

    <button class="custom" id="customBtn">Customize
      <svg width="9" height="9" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.600" stroke-linejoin="round"><path d="M11 2l3 3-8.500 8.500L2 14l.5-3.500z"/></svg>
    </button>
  </main>
  <div class="pop" id="pop"></div><div class="pop ctx" id="ctx"></div>
  <div class="ov" id="ov"><div class="modal" id="modal"></div></div>
</div>

<script>
(function(){
var $=function(i){return document.getElementById(i)};
var S={get:function(k,d){try{var v=localStorage.getItem('solis.'+k);return v?JSON.parse(v):d}catch(e){return d}},
       set:function(k,v){try{localStorage.setItem('solis.'+k,JSON.stringify(v))}catch(e){}}};
function esc(t){return String(t).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
var page=document.querySelector('.page'),pop=$('pop'),ov=$('ov'),mod=$('modal'),ctx=$('ctx');

/* ---------- Ayarlar ve tema ---------- */
var cfg=Object.assign({theme:'dark',bg:'',tiles:true,info:true,weather:false},S.get('cfg',{}));
function applyCfg(){
  document.documentElement.dataset.theme=cfg.theme;
  page.style.setProperty('--pagebg',cfg.theme==='dark'&&cfg.bg?cfg.bg:'');
  page.classList.toggle('hide-tiles',!cfg.tiles);
  page.classList.toggle('hide-info',!cfg.info);
  S.set('cfg',cfg);
}
applyCfg();

/* ---------- Açılır pencereler ---------- */
function closePop(){pop.classList.remove('open')}
function showPop(html,bind){pop.onclick=null;pop.innerHTML=html;pop.classList.add('open');if(bind)bind()}
function closeModal(){ov.classList.remove('open')}
function showModal(html,bind){mod.onclick=null;mod.innerHTML=html;ov.classList.add('open');if(bind)bind()}
document.addEventListener('click',function(e){
  if(!pop.contains(e.target)&&!e.target.closest('[data-pop]'))closePop();
  if(!ctx.contains(e.target))ctx.classList.remove('open');
});
ov.addEventListener('click',function(e){if(e.target===ov)closeModal()});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){closePop();closeModal();ctx.classList.remove('open')}});
function sw(on){return '<button class="sw'+(on?' on':'')+'" role="switch" aria-checked="'+on+'"></button>'}

/* ---------- Arama (DuckDuckGo) ---------- */
var URLRE=/^(https?:\/\/)?([\w-]+\.)+[a-z]{2,}(\/.*)?$/i;
var hist=S.get('hist',[]);
function go(v){
  v=v.trim();if(!v)return;var u;
  if(URLRE.test(v))u=/^https?:\/\//i.test(v)?v:'https://'+v;
  else{hist=[v].concat(hist.filter(function(x){return x!==v})).slice(0,30);S.set('hist',hist);u='https://duckduckgo.com/?q='+encodeURIComponent(v)}
  try{window.top.location.href=u}catch(_){window.location.href=u}
}
var qi=$('q'),sug=$('sug'),rows=[],sel=-1,timer,ctl;
var SI='<svg width="12" height="12" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="7.500" cy="7.500" r="5"/><path d="M11.500 11.500L16 16"/></svg>';
function drawSug(){
  if(!rows.length){sug.classList.remove('open');return}
  sug.innerHTML=rows.map(function(r,i){return '<div data-i="'+i+'"'+(i===sel?' class="sel"':'')+'>'+SI+'<span>'+esc(r)+'</span></div>'}).join('');
  sug.classList.add('open');
}
function localMatches(v){var l=v.toLowerCase();return hist.filter(function(h){return h.toLowerCase().indexOf(l)>-1}).slice(0,3)}
function dedupe(a,n){var seen={};return a.filter(function(x){if(!x||seen[x])return false;return seen[x]=true}).slice(0,n)}
function suggest(){
  var v=qi.value.trim();sel=-1;
  if(!v){rows=hist.slice(0,5);drawSug();return}
  rows=dedupe([v].concat(localMatches(v)),7);drawSug();
  clearTimeout(timer);
  timer=setTimeout(function(){
    if(ctl)ctl.abort();
    ctl=window.AbortController?new AbortController():null;
    fetch('https://duckduckgo.com/ac/?type=list&q='+encodeURIComponent(v),ctl?{signal:ctl.signal}:{})
      .then(function(r){return r.json()})
      .then(function(d){
        var rem=((d&&d[1])||[]).map(function(x){return typeof x==='string'?x:x.phrase});
        if(qi.value.trim()!==v)return;
        rows=dedupe([v].concat(localMatches(v),rem),7);sel=-1;drawSug();
      }).catch(function(){});
  },180);
}
qi.addEventListener('input',suggest);
qi.addEventListener('focus',suggest);
qi.addEventListener('blur',function(){setTimeout(function(){sug.classList.remove('open')},150)});
qi.addEventListener('keydown',function(e){
  if(e.key==='ArrowDown'||e.key==='ArrowUp'){
    if(!rows.length)return;e.preventDefault();
    sel=e.key==='ArrowDown'?(sel+1)%rows.length:(sel<=0?rows.length-1:sel-1);
    qi.value=rows[sel];drawSug();
  }else if(e.key==='Escape'){sug.classList.remove('open')}
});
sug.addEventListener('mousedown',function(e){
  var d=e.target.closest('[data-i]');if(!d)return;e.preventDefault();go(rows[+d.dataset.i]);
});
sug.addEventListener('touchstart',function(e){
  var d=e.target.closest('[data-i]');if(!d)return;e.preventDefault();go(rows[+d.dataset.i]);
},{passive:false});
$('searchForm').addEventListener('submit',function(e){e.preventDefault();go(sel>-1&&rows[sel]?rows[sel]:qi.value)});
$('urlForm').addEventListener('submit',function(e){e.preventDefault();go($('urlInput').value)});

/* ---------- Kısayollar ---------- */
var tiles=$('tiles'),addBtn=$('addBtn'),pressed=false;
var sc=S.get('sc',null);
if(!sc){
  sc=[].map.call(tiles.querySelectorAll('.tile[target]'),function(a){
    return{name:a.querySelector('small').textContent,url:a.href,icon:a.querySelector('.ic').innerHTML,sp:!!a.querySelector('em'),b:1};
  });
}
var DEFAULT_SC=JSON.parse(JSON.stringify(sc));
function letterIcon(n){return '<b style="background:#6b6a78;color:#fff;font-size:13px">'+esc(n.charAt(0).toUpperCase())+'</b>'}
function renderSc(){
  [].forEach.call(tiles.querySelectorAll('.tile[target]'),function(a){a.remove()});
  sc.forEach(function(it,i){
    var a=document.createElement('a');
    a.className='tile';a.href=it.url;a.target='_blank';a.rel='noopener';a.dataset.i=i;
    a.innerHTML='<div class="ic">'+(it.icon||letterIcon(it.name))+'</div><small>'+esc(it.name)+'</small>'+(it.sp?'<em>Sponsored</em>':'');
    tiles.insertBefore(a,addBtn);
  });
}
function openCtx(x,y,i){
  ctx.innerHTML='<button class="mi" data-a="e">Düzenle</button><button class="mi" data-a="d">Sil</button>';
  ctx.style.left=Math.max(8,Math.min(x,window.innerWidth-180))+'px';
  ctx.style.top=Math.max(8,Math.min(y,window.innerHeight-100))+'px';
  ctx.classList.add('open');
  ctx.onclick=function(e){
    var b=e.target.closest('[data-a]');if(!b)return;
    ctx.classList.remove('open');
    if(b.dataset.a==='e')shortcutForm(i);else{sc.splice(i,1);S.set('sc',sc);renderSc()}
  };
}
tiles.addEventListener('contextmenu',function(e){
  var a=e.target.closest('.tile[data-i]');if(!a)return;
  e.preventDefault();openCtx(e.clientX,e.clientY,+a.dataset.i);
});
var lp;
tiles.addEventListener('touchstart',function(e){
  var a=e.target.closest('.tile[data-i]');if(!a)return;var t=e.touches[0];
  lp=setTimeout(function(){pressed=true;openCtx(t.clientX,t.clientY,+a.dataset.i)},550);
},{passive:true});
['touchend','touchmove','touchcancel'].forEach(function(n){tiles.addEventListener(n,function(){clearTimeout(lp)},{passive:true})});
tiles.addEventListener('click',function(e){if(pressed){e.preventDefault();pressed=false}},true);
function shortcutForm(i){
  var it=i>=0?sc[i]:{name:'',url:''};
  showModal('<h2>'+(i>=0?'Kısayolu düzenle':'Kısayol ekle')+'</h2><label>Ad</label><input id="f_n" type="text" value="'+esc(it.name)+'"><label>Adres</label><input id="f_u" type="text" placeholder="ornek.com" value="'+esc(it.url)+'"><div class="btns"><button class="btn" id="f_c">İptal</button><button class="btn pri" id="f_s">Kaydet</button></div>',function(){
    $('f_c').onclick=closeModal;
    $('f_s').onclick=function(){
      var u=$('f_u').value.trim(),n=$('f_n').value.trim(),host;
      if(!u){$('f_u').focus();return}
      if(!/^https?:\/\//i.test(u))u='https://'+u;
      try{host=new URL(u).hostname.replace(/^www\./,'')}catch(e){$('f_u').focus();return}
      n=n||host.split('.')[0];
      if(i>=0){sc[i].name=n;sc[i].url=u}else sc.push({name:n,url:u});
      S.set('sc',sc);renderSc();closeModal();
    };
    $('f_n').focus();
  });
}
addBtn.addEventListener('click',function(e){e.preventDefault();shortcutForm(-1)});
renderSc();

/* ---------- Özelleştir ---------- */
var BGS=[['','Varsayılan','#1c1b22'],['#0c1220','Gece mavisi','#0c1220'],['#000000','Siyah','#000000'],['#241a33','Mor','#241a33'],['#14261f','Orman','#14261f'],['#2a1a12','Kahve','#2a1a12']];
function openCustomize(){
  closePop();
  showModal('<h2>Özelleştir</h2>'
    +'<label>Tema</label><div class="btns" style="justify-content:flex-start;margin-top:0"><button class="btn'+(cfg.theme==='dark'?' pri':'')+'" data-t="dark">Koyu</button><button class="btn'+(cfg.theme==='light'?' pri':'')+'" data-t="light">Açık</button></div>'
    +'<label>Arka plan'+(cfg.theme==='light'?' (yalnızca koyu temada)':'')+'</label><div class="swatches">'+BGS.map(function(b){return '<button title="'+b[1]+'" data-bg="'+b[0]+'" class="'+(cfg.bg===b[0]?'sel':'')+'" style="background:'+b[2]+'"></button>'}).join('')+'</div>'
    +'<div class="row" data-k="tiles"><span>Kısayolları göster</span>'+sw(cfg.tiles)+'</div>'
    +'<div class="row" data-k="info"><span>Saat, tarih ve hava durumu</span>'+sw(cfg.info)+'</div>'
    +'<div class="row"><span>Arama geçmişi<small>'+hist.length+' kayıt</small></span><button class="btn" id="c_h">Temizle</button></div>'
    +'<div class="btns"><button class="btn" id="c_r">Kısayolları sıfırla</button><button class="btn pri" id="c_x">Kapat</button></div>',
  function(){
    mod.onclick=function(e){
      var t=e.target.closest('[data-t]'),b=e.target.closest('[data-bg]'),r=e.target.closest('[data-k]');
      if(t){cfg.theme=t.dataset.t;applyCfg();openCustomize()}
      else if(b){cfg.bg=b.dataset.bg;applyCfg();openCustomize()}
      else if(r){cfg[r.dataset.k]=!cfg[r.dataset.k];applyCfg();openCustomize()}
      else if(e.target.id==='c_h'){hist=[];S.set('hist',hist);openCustomize()}
      else if(e.target.id==='c_r'){sc=JSON.parse(JSON.stringify(DEFAULT_SC));S.set('sc',sc);renderSc()}
      else if(e.target.id==='c_x')closeModal();
    };
  });
}
$('customBtn').addEventListener('click',openCustomize);

/* ---------- Hesap, uzantılar, menü ---------- */
var user=S.get('user',false);
function accountPop(){
  showPop('<div class="row"><div class="avatar">'+(user?'S':'M')+'</div><div style="flex:1"><b>'+(user?'Solis Kullanıcısı':'Misafir')+'</b><small>'+(user?'Eşitleme açık (demo)':'Giriş yapılmadı')+'</small></div></div><div class="sep"></div><button class="mi" id="a_b">'+(user?'Çıkış yap':'Giriş yap (demo)')+'</button>',function(){
    $('a_b').onclick=function(){user=!user;S.set('user',user);accountPop()};
  });
}
function extPop(){showPop('<h3>Uzantılar</h3><p>Henüz yüklü uzantı yok.</p>')}
function listModal(title,items,empty,extra){
  showModal('<h2>'+title+'</h2><div class="items">'+(items.length?items.join(''):'<p>'+empty+'</p>')+'</div><div class="btns">'+(extra||'')+'<button class="btn pri" id="l_x">Kapat</button></div>',function(){
    $('l_x').onclick=closeModal;
    mod.onclick=function(e){
      var li=e.target.closest('[data-q]');
      if(li){go(li.dataset.q)}
      else if(e.target.id==='l_c'){hist=[];S.set('hist',hist);historyModal()}
    };
  });
}
function historyModal(){
  listModal('Geçmiş',hist.map(function(h){return '<div class="li" data-q="'+esc(h)+'">'+esc(h)+'</div>'}),'Henüz arama geçmişi yok.',hist.length?'<button class="btn" id="l_c">Geçmişi temizle</button>':'');
}
function bookmarksModal(){
  listModal('Yer imleri',sc.map(function(s){return '<a href="'+esc(s.url)+'" target="_blank" rel="noopener">'+esc(s.name)+'<br><small style="color:var(--muted)">'+esc(s.url)+'</small></a>'}),'Yer imi yok.');
}
function menuPop(){
  showPop('<button class="mi" data-m="new">Yeni sekme</button><button class="mi" data-m="hist">Geçmiş</button><button class="mi" data-m="bm">Yer imleri</button><div class="sep"></div>'
    +'<button class="mi" data-m="theme">'+(cfg.theme==='dark'?'Açık temaya geç':'Koyu temaya geç')+'</button><button class="mi" data-m="set">Ayarlar</button><div class="sep"></div><button class="mi" data-m="about">Solis Browser hakkında</button>',function(){
    pop.onclick=function(e){
      var b=e.target.closest('[data-m]');if(!b)return;var m=b.dataset.m;closePop();
      if(m==='new'&&window.solisNewTab)window.solisNewTab();
      else if(m==='hist')historyModal();
      else if(m==='bm')bookmarksModal();
      else if(m==='theme'){cfg.theme=cfg.theme==='dark'?'light':'dark';applyCfg()}
      else if(m==='set')openCustomize();
      else if(m==='about')showModal('<h2>Solis Browser</h2><p>Bu, Solis Browser yeni sekme sayfasının demo sürümüdür.</p><div class="btns"><button class="btn pri" id="ab_x">Kapat</button></div>',function(){$('ab_x').onclick=closeModal});
    };
  });
}
var acc=document.querySelector('[aria-label="Hesap"]'),ext=document.querySelector('[aria-label="Uzantılar"]'),mnu=document.querySelector('[aria-label="Menü"]');
[acc,ext,mnu].forEach(function(b){b.setAttribute('data-pop','1')});
acc.addEventListener('click',accountPop);ext.addEventListener('click',extPop);mnu.addEventListener('click',menuPop);

/* ---------- Saat, tarih, hava durumu ---------- */
function tick(){
  var d=new Date();
  $('clk').textContent=d.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
  $('dt').textContent=d.toLocaleDateString([],{weekday:'long',day:'numeric',month:'long'});
}
tick();setInterval(tick,15000);
var wx=$('wx');
function wIcon(c){return c===0?'☀️':c<3?'🌤️':c===3?'☁️':c<50?'🌫️':c<70?'🌧️':c<80?'❄️':c<90?'🌦️':'⛈️'}
function loadWx(){
  if(!navigator.geolocation){wx.textContent='Hava durumu yok';return}
  wx.textContent='Hava durumu…';
  navigator.geolocation.getCurrentPosition(function(p){
    fetch('https://api.open-meteo.com/v1/forecast?latitude='+p.coords.latitude+'&longitude='+p.coords.longitude+'&current=temperature_2m,weather_code')
      .then(function(r){return r.json()})
      .then(function(j){wx.textContent=wIcon(j.current.weather_code)+' '+Math.round(j.current.temperature_2m)+'°';cfg.weather=true;applyCfg()})
      .catch(function(){wx.textContent='Hava durumu alınamadı'});
  },function(){cfg.weather=false;applyCfg();wx.textContent='Konum izni verilmedi'},{timeout:10000});
}
if(cfg.weather)loadWx();
wx.addEventListener('click',loadWx);
})();
</script>
<script>
(function(){
  var tabList=document.getElementById('tabList'),page=document.querySelector('.page'),
      urlInput=document.getElementById('urlInput'),q=document.getElementById('q');
  var SUN='<svg width="16" height="16" viewBox="0 0 100 100"><use href="#solis"/></svg>';
  var X='<svg width="12" height="12" viewBox="0 0 12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 2l8 8M10 2l-8 8"/></svg>';
  var saved=null;try{saved=JSON.parse(localStorage.getItem('solis.tabs'))}catch(e){}
  var tabs=saved&&saved.tabs&&saved.tabs.length?saved.tabs:[{id:1,type:'welcome',title:'Welcome to Solis'},{id:2,type:'new',title:'New Tab'}],
      active=saved&&saved.active||2,nextId=saved&&saved.nextId||3;
  if(!tabs.some(function(t){return t.id===active}))active=tabs[0].id;

  function current(){return tabs.filter(function(t){return t.id===active})[0]}
  function render(){
    tabList.innerHTML='';
    tabs.forEach(function(t){
      var el=document.createElement('div');
      el.className='tab'+(t.id===active?' active':'');
      el.setAttribute('role','tab');
      el.innerHTML='<div class="fav">'+(t.type==='welcome'?'W':SUN)+'</div><span></span><button class="x" aria-label="Close tab" title="Close tab">'+X+'</button>';
      el.querySelector('span').textContent=t.title;
      el.addEventListener('click',function(){active=t.id;render()});
      el.querySelector('.x').addEventListener('click',function(e){e.stopPropagation();closeTab(t.id)});
      tabList.appendChild(el);
      if(t.id===active) el.scrollIntoView({block:'nearest',inline:'nearest'});
    });
    var c=current(), isWelcome=c.type==='welcome';
    page.classList.toggle('is-welcome',isWelcome);
    urlInput.value='https://solis.browser/'+(isWelcome?'welcome':'newtab');
    if(!isWelcome) q.value='';
    try{localStorage.setItem('solis.tabs',JSON.stringify({tabs:tabs,active:active,nextId:nextId}))}catch(e){}
  }
  function openTab(){tabs.push({id:nextId,type:'new',title:'New Tab'});active=nextId++;render()}
  function closeTab(id){
    var i=tabs.map(function(t){return t.id}).indexOf(id);
    if(i<0) return;
    tabs.splice(i,1);
    if(!tabs.length){openTab();return}
    if(id===active) active=tabs[Math.min(i,tabs.length-1)].id;
    render();
  }
  document.getElementById('newTabBtn').addEventListener('click',openTab);
  document.getElementById('welcomeNew').addEventListener('click',openTab);
  window.solisNewTab=openTab;
  render();
})();
</script>
</body>
</html>
