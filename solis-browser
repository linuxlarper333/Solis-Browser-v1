<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <radialGradient id="sunG" cx="50%" cy="46%" r="56%"><stop offset="0" stop-color="#f8aa0e"/><stop offset=".45" stop-color="#f58a1c"/><stop offset="1" stop-color="#f15a22"/></radialGradient>
    <symbol id="solis" viewBox="0 0 100 100">
      <mask id="sunM" maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
        <circle cx="50" cy="50" r="50" fill="#fff"/>
        <g fill="#000">
          <polygon points="36,13.2 82,10.6 82,13.4"/>
          <polygon points="0,30.4 47,33.2 0,34"/>
          <polygon points="68.5,25.8 100,24.4 100,27"/>
          <polygon points="55,45.2 100,43.2 100,46.2"/>
          <polygon points="0,52.4 55,55.2 0,55.8"/>
          <polygon points="50.4,67.2 100,65.1 100,67.8"/>
          <polygon points="3,79.6 30,81.5 3,82.2"/>
